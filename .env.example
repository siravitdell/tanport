# Copy to .env and fill in. Never commit .env.

# --- Infrastructure (matches docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://tanport:tanport@localhost:5433/tanport
TEST_DATABASE_URL=postgresql+asyncpg://tanport:tanport@localhost:5433/tanport_test
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/15

# --- Market data ---
# https://finnhub.io/dashboard  (free: 60 calls/min)
FINNHUB_API_KEY=
# https://www.tiingo.com/account/api/token  (free: 50 req/h, 1000 req/day)
TIINGO_API_KEY=
# https://www.alphavantage.co/support/#api-key  (free: 25 req/day)
ALPHAVANTAGE_API_KEY=

# --- FX: Bank of Thailand API portal (https://portal.api.bot.or.th) ---
BOT_API_TOKEN=

# --- Auth ---
# Required to register an account; leave empty to disable registration.
INVITE_CODE=
SESSION_TTL_DAYS=30
# Set to true when served over HTTPS.
COOKIE_SECURE=false

# --- Domain defaults ---
WITHHOLDING_RATE=0.15
BIG_MOVE_THRESHOLD_PCT=3

# --- LLM (Phase 2) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- LINE Messaging API (Phase 3) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
